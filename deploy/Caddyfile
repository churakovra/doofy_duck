:80 {
    route {
        respond /internal/* 404
        @coreRuns path /api/v1/runs /api/v1/runs/*
        handle @coreRuns {
            reverse_proxy core:8080
        }
        handle /api/* {
            reverse_proxy platform:8080
        }
        handle /.well-known/jwks.json {
            reverse_proxy platform:8080
        }
        handle /healthz {
            reverse_proxy platform:8080
        }
        handle /readyz {
            reverse_proxy platform:8080
        }
        handle {
            root * /srv/game
            try_files {path} /index.html
            file_server
        }
    }
}
